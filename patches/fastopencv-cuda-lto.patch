--- a/cmake/OpenCVDetectCUDAUtils.cmake
+++ b/cmake/OpenCVDetectCUDAUtils.cmake
@@ -336,6 +336,12 @@ macro(ocv_cuda_filter_options)
   foreach(var CMAKE_CXX_FLAGS CMAKE_CXX_FLAGS_RELEASE CMAKE_CXX_FLAGS_DEBUG)
     set(${var}_backup_in_cuda_compile_ "${${var}}")
 
+    # FastOpenCV: GCC LTO несовместим с fatbin-символами nvcc - host-заглушки
+    # .cu попадают в LTO-IR, и при слиянии ltrans-модулей ассемблер видит
+    # дубликаты fatbinData. Убираем -flto* только из host-компиляции CUDA;
+    # чистый C++ остаётся с LTO.
+    string(REGEX REPLACE "(^| )-flto(=[^ ]*)?( |$)" "\\1" ${var} "${${var}}")
+
     if (CV_CLANG)
